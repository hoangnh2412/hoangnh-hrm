{
  "ConnectionStrings": {
    "AutoMigrate": "false",
    "AppDbContext": "Host=localhost;Port=5432;User ID=admin;Password=Admin@123;Database=hrm;Pooling=true;"
  },
  "Cache": {
    "Items": {
      "ConnectionString": {
        "Key": "conn:{dbid}",
        "MemSeconds": 14400
      }
    }
  },
  "Json": {
    "IgnoreNull": true,
    "NamingPolicy": "CamelCase"
  },
  "Cors": {
    "Default": {
      "AllowAnyOrigin": true,
      "AllowedOrigins": [],
      "AllowedAllHeaders": true,
      "AllowedHeaders": [],
      "AllowedAllMethods": true,
      "AllowedMethods": [],
      "AllowCredentials": false
    }
  },
  "Swagger": {
    "Enable": true,
    "Versions": ["v1"],
    "ApiResponseDocumentationPathPrefixes": ["/api"]
  },
  "Middlewares": {
    "ApiResponseWrapper": {
      "IsEnable": true,
      "Includes": ["^/api"]
    }
  },
  "HealthChecks": {
    "DefaultTimeoutSeconds": 5,
    "MarkStartupCompleteOnApplicationStarted": true
  },
  "OTEL": {
    "Name": "hrm",
    "Namespace": "hrm",
    "InstanceId": "local",
    "Resource": {
      "IncludeHostDetector": true,
      "IncludeContainerDetector": true
    },
    "Attributes": {},
    "Logging": {
      "IncludeConsoleExporter": false,
      "Endpoint": "http://localhost:4317",
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    },
    "Tracing": {
      "Endpoint": "http://localhost:4317",
      "Sampler": "ParentBasedRatio",
      "TraceIdRatio": 1.0,
      "TimeoutMilliseconds": 10000,
      "HttpTraceEnrichment": {
        "CaptureRequestHeaders": true,
        "CaptureResponseHeaders": true,
        "AllowedRequestHeaderNames": [
          "traceparent",
          "tracestate",
          "x-request-id",
          "x-correlation-id"
        ],
        "AllowedResponseHeaderNames": [
          "content-type"
        ],
        "MaxHeaderValueLength": 256
      },
      "AspNetCoreInstrumentation": {
        "RecordException": true,
        "ExcludedPathPrefixes": ["/health", "/swagger"]
      },
      "HttpClient": {
        "ExcludedUrlSubstrings": []
      }
    },
    "Metric": {
      "Endpoint": "http://localhost:4317",
      "HistogramAggregation": "explicit",
      "IncludeConsoleExporter": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
