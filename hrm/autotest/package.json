{
  "name": "hrm-autotest",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prebuild": "node ./scripts/ensure-linked-deps.mjs",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test --config drivers/playwright/playwright.config.ts",
    "test:api": "playwright test --config drivers/playwright/playwright.config.ts tests/api",
    "test:ui": "SLOW_MO=400 playwright test --config drivers/playwright/playwright.config.ts tests/ui --headed"
  },
  "dependencies": {
    "@jarvis/autotest": "file:../../jarvis/autotest/core",
    "@jarvis/autotest.playwright": "file:../../jarvis/autotest/playwright"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
